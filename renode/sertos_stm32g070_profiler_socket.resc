:name: sertos_stm32g070_profiler_socket
:description: Run the G070 demo with USART2 exposed as a Renode TCP socket for profiler dumps.

$profilerPort ?= 3456

mach create "sertos_stm32g070"
machine LoadPlatformDescription @platforms/cpus/stm32g0.repl

timer1 Frequency 16000000
timer6 Frequency 16000000
nvic Frequency 16000000
cpu PerformanceInMips 16

emulation CreateServerSocketTerminal $profilerPort "profilerUart" false
connector Connect sysbus.usart2 profilerUart

$bin ?= $ORIGIN/../build/Debug/sertos_stm32g070.elf
sysbus LoadELF $bin
start
