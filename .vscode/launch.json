{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "name": "Debug NUCLEO-G070RB",
            "type": "cortex-debug",
            "request": "launch",

            "executable": "${workspaceFolder}/build/Debug/sertos_stm32g070.elf",

            "servertype": "stlink",
            "device": "STM32G070RB",
            "interface": "swd",
            "serialNumber": "066FFF343339415043011534",

            "armToolchainPath": "C:/ST/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin",
            "stlinkPath": "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer": "C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin",

            "serverArgs": [
                "--initialize-reset",
                "--temp-path",
                "C:/temp"
            ],

            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}